{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "python scripts/rag_query.py*": "allow",
      "python scripts/rag_sync.py*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",
      "* > .env*": "deny",
      "cat *.env*": "deny",
      "type *.env*": "deny"
    },
    "read": {
      "**/.env*": "deny"
    }
  }
}
